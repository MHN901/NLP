   "source": [
    "sentence = \"Transformers use self-attention to understand language.\"\n",
    "\n",
    "# Convert the sentence into token IDs\n",
    "inputs = bert_tokenizer(sentence, return_tensors=\"pt\")\n",
    "tokens = bert_tokenizer.convert_ids_to_tokens(inputs[\"input_ids\"][0])\n",
    "\n",
    "# Run the model and get the attention weights\n",
    "with torch.no_grad():\n",
    "    outputs = bert_model(**inputs, output_attentions=True)\n",
    "\n",
    "# Third layer = index 2, second head = index 1\n",
    "attention = outputs.attentions[2][0, 1]\n",
    "\n",
    "print(\"Tokens:\", tokens)\n",
    "print(\"Attention shape:\", attention.shape)\n",
    "print(\"Attention weights:\\n\", attention)"
   ]
