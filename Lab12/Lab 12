    "from transformers import AutoTokenizer, AutoModel\n",
    "import torch\n",
    "\n",
    "# Load BERT tokenizer and model (eager mode so we can get attention weights)\n",
    "bert_tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n",
    "bert_model = AutoModel.from_pretrained(\"bert-base-uncased\", attn_implementation=\"eager\")\n",
    "bert_model.eval()\n",
    "\n",
    "# 1. Number of layers and attention heads per layer\n",
    "num_layers = bert_model.config.num_hidden_layers\n",
    "num_heads = bert_model.config.num_attention_heads\n",
    "\n",
    "print(\"Transformer layers:\", num_layers)\n",
    "print(\"Attention heads per layer:\", num_heads)\n",
    "\n",
    "# 2. Total attention heads in all layers\n",
    "total_heads = num_layers * num_heads\n",
    "print(\"Total attention heads:\", total_heads)"
   ]
